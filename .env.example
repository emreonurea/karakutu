# Telegram bot anahtarı (BotFather'dan alınır) — ZORUNLU
TELEGRAM_BOT_TOKEN=

# Sadece bu Telegram kullanıcı numarası botu kullanabilsin (önerilir).
# Kendi numaranı Telegram'da @userinfobot ile öğrenebilirsin.
TELEGRAM_OWNER_ID=

# Yapay zeka beyni için Anthropic API anahtarı (opsiyonel).
# Boş bırakırsan bot sadece komutlarla çalışır, serbest sohbet etmez.
ANTHROPIC_API_KEY=

# Hangi model kullanılsın (opsiyonel). Daha ucuz seçenek: claude-haiku-5-5
KARAKUTU_MODEL=claude-opus-5-5

# Yeşilea'nın web adresi (opsiyonel, /durum komutu bunu kontrol eder)
YESILEA_URL=https://emreonurea.github.io/yesilea/
